### Prompt: 
Give me a minimal C example showing how to initialize an AF_XDP socket and UMEM rings.
### Reply:
Setting up an AF_XDP socket directly requires two components:

The Kernel Program (XDP): Inspects incoming packets and returns bpf_redirect_map(&xsks_map, queue_id, 0) to steer frames toward the socket.

The User-Space Program (C): Allocates the UMEM memory area, creates the four rings, binds the socket to a network interface queue, and polls for packets.

The standard and recommended way to configure AF_XDP in C is using libxdp (or libbpf's xsk.h helper wrapper), which eliminates hundreds of lines of raw mmap() and socket setup boilerplate.

1. The Kernel-Side BPF Program (xdp_sock.bpf.c)
This simple XDP program redirects all traffic on the interface to the socket bound to that queue.

C
#include <linux/bpf.h>
#include <bpf/bpf_helpers.h>

/* Map holding AF_XDP socket file descriptors indexed by NIC queue ID */
struct {
    __uint(type, BPF_MAP_TYPE_XSKMAP);
    __uint(max_entries, 64);
    __type(key, __u32);
    __type(value, __u32);
} xsks_map SEC(".maps");

SEC("xdp")
int xdp_sock_prog(struct xdp_md *ctx)
{
    __u32 index = ctx->rx_queue_index;

    /* Redirect packet to AF_XDP socket if one exists for this queue */
    if (bpf_map_lookup_elem(&xsks_map, &index))
        return bpf_redirect_map(&xsks_map, index, 0);

    return XDP_PASS;
}

char _license[] SEC("license") = "GPL";
2. The User-Space Program (af_xdp_user.c)
This program allocates the packet memory (UMEM), sets up the Fill and Rx rings, populates the Fill ring with empty chunk addresses, and polls for incoming frames.

C
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <unistd.h>
#include <poll.h>
#include <sys/mman.h>
#include <xdp/xsk.h>
#include <bpf/bpf.h>

#define NUM_FRAMES         2048
#define FRAME_SIZE         XSK_UMEM__DEFAULT_FRAME_SIZE // 4096 bytes
#define BATCH_SIZE         64
#define IF_NAME            "eth0"
#define QUEUE_ID           0

struct xsk_umem_info {
    struct xsk_ring_prod fq; // Fill queue
    struct xsk_ring_cons cq; // Completion queue
    struct xsk_umem *umem;
    void *buffer;
};

struct xsk_socket_info {
    struct xsk_ring_cons rx;
    struct xsk_ring_prod tx;
    struct xsk_socket *xsk;
    struct xsk_umem_info *umem;
};

/* Allocate memory and register UMEM with the kernel */
static struct xsk_umem_info *configure_umem(void)
{
    struct xsk_umem_info *umem_info = calloc(1, sizeof(*umem_info));
    size_t buffer_size = NUM_FRAMES * FRAME_SIZE;

    /* Allocate page-aligned memory for the packet pool */
    if (posix_memalign(&umem_info->buffer, getpagesize(), buffer_size)) {
        perror("posix_memalign failed");
        exit(EXIT_FAILURE);
    }

    struct xsk_umem_config cfg = {
        .fill_size = NUM_FRAMES,
        .comp_size = NUM_FRAMES,
        .frame_size = FRAME_SIZE,
        .frame_headroom = XSK_UMEM__DEFAULT_FRAME_HEADROOM,
        .flags = 0
    };

    int ret = xsk_umem__create(&umem_info->umem, umem_info->buffer, buffer_size,
                               &umem_info->fq, &umem_info->cq, &cfg);
    if (ret) {
        fprintf(stderr, "xsk_umem__create failed: %s\n", strerror(-ret));
        exit(EXIT_FAILURE);
    }

    return umem_info;
}

/* Create AF_XDP socket and bind it to the interface queue */
static struct xsk_socket_info *configure_socket(struct xsk_umem_info *umem, const char *ifname, uint32_t queue_id)
{
    struct xsk_socket_info *xsk_info = calloc(1, sizeof(*xsk_info));
    xsk_info->umem = umem;

    struct xsk_socket_config cfg = {
        .rx_size = XSK_RING_CONS__DEFAULT_NUM_DESCS,
        .tx_size = XSK_RING_PROD__DEFAULT_NUM_DESCS,
        .libxdp_flags = XSK_LIBXDP_FLAGS__INHIBIT_PROG_LOAD, // If loading XDP manually
        .xdp_flags = XDP_FLAGS_UPDATE_IF_NOEXIST | XDP_FLAGS_DRV_MODE, // Or XDP_FLAGS_SKB_MODE
        .bind_flags = XDP_USE_NEED_WAKEUP | XDP_COPY // Use XDP_ZEROCOPY if driver supports it
    };

    int ret = xsk_socket__create(&xsk_info->xsk, ifname, queue_id,
                                 umem->umem, &xsk_info->rx, &xsk_info->tx, &cfg);
    if (ret) {
        fprintf(stderr, "xsk_socket__create failed: %s\n", strerror(-ret));
        exit(EXIT_FAILURE);
    }

    return xsk_info;
}

int main(void)
{
    struct xsk_umem_info *umem = configure_umem();
    struct xsk_socket_info *xsk = configure_socket(umem, IF_NAME, QUEUE_ID);

    /* Populate the Fill Ring with initial empty memory buffers */
    uint32_t idx;
    int ret = xsk_ring_prod__reserve(&umem->fq, NUM_FRAMES, &idx);
    if (ret != NUM_FRAMES) {
        fprintf(stderr, "Failed to reserve fill ring descriptors\n");
        return 1;
    }

    for (int i = 0; i < NUM_FRAMES; i++) {
        *xsk_ring_prod__fill_addr(&umem->fq, idx++) = i * FRAME_SIZE;
    }
    xsk_ring_prod__submit(&umem->fq, NUM_FRAMES);

    printf("AF_XDP socket initialized on %s (queue %d). Waiting for packets...\n", IF_NAME, QUEUE_ID);

    struct pollfd pfd = {
        .fd = xsk_socket__fd(xsk->xsk),
        .events = POLLIN
    };

    /* Packet processing loop */
    while (1) {
        int nfds = poll(&pfd, 1, 1000);
        if (nfds <= 0)
            continue;

        uint32_t idx_rx = 0;
        unsigned int rcvd = xsk_ring_cons__peek(&xsk->rx, BATCH_SIZE, &idx_rx);
        if (!rcvd)
            continue;

        /* Prepare to return consumed buffers back to the Fill Ring */
        uint32_t idx_fq = 0;
        xsk_ring_prod__reserve(&umem->fq, rcvd, &idx_fq);

        for (unsigned int i = 0; i < rcvd; i++) {
            const struct xdp_desc *desc = xsk_ring_cons__rx_desc(&xsk->rx, idx_rx++);
            uint64_t addr = desc->addr;
            uint32_t len = desc->len;

            /* Access raw packet bytes directly in user-space UMEM */
            uint8_t *pkt = xsk_umem__get_data(umem->buffer, addr);
            printf("Received packet: length = %u bytes, first byte = 0x%02x\n", len, pkt[0]);

            /* Recycle the chunk back to the Fill ring */
            *xsk_ring_prod__fill_addr(&umem->fq, idx_fq++) = addr;
        }

        xsk_ring_cons__release(&xsk->rx, rcvd);
        xsk_ring_prod__submit(&umem->fq, rcvd);
    }

    return 0;
}
3. Compilation & Execution
Install the prerequisite libraries on Ubuntu/Debian:

Bash
sudo apt-get install libxdp-dev libbpf-dev clang llvm
Compile the kernel BPF program:

Bash
clang -O2 -g -Wall -target bpf -c xdp_sock.bpf.c -o xdp_sock.bpf.o
Compile the user-space driver application:

Bash
gcc -O2 -Wall af_xdp_user.c -o af_xdp_user -lxdp -lbpf
Run the application (requires root privileges for network namespace & DMA binding):

Bash
sudo ./af_xdp_user
